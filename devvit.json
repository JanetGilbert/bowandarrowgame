{
  "$schema": "https://developers.reddit.com/schema/config-file.v1.json",
  "name": "zencrossbow",
  "post": {
    "dir": "dist/client",
    "entrypoints": {
      "default": {
        "entry": "preview.html",
        "height": "regular",
        "inline": true
      },
      "game": {
        "entry": "index.html"
      }
    }
  },
  "media": {
    "dir": "assets"
  },
  "server": {
    "dir": "dist/server",
    "entry": "index.cjs"
  },
  "menu": {
    "items": [
      {
        "label": "Create a new post",
        "description": "zencrossbow",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/post-create"
      },
      {
        "label": "Clean high score table",
        "description": "Remove high score entries with invalid or profane names",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/clean-highscores"
      }
    ]
  },
  "triggers": {
    "onAppInstall": "/internal/on-app-install"
  },
  "dev": {
    "subreddit": "zencrossbow_dev"
  }
}
